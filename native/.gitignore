# Every build output, cache and temp file of the Native edition (REPO-002).
.build/

# SwiftPM / Xcode local state. The package is built with native/build.sh only.
.swiftpm/
*.xcodeproj
xcuserdata/
.DS_Store

# Per-file compiler outputs that an editor's SourceKit-LSP can drop next to the
# package when it type-checks files outside a SwiftPM build. Never source.
/*.swiftmodule
/*.swiftdeps
/*.dia
/*-[0-9].d

