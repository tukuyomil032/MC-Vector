// Hand-written. The header next to it is generated by UniFFI (native/build.sh).
// The static library is found through `-Xlinker -L native/.build/rust/lib`,
// where native/build.sh places only libmcvector_ffi.a.
module MCVectorFFI {
    header "MCVectorFFI.h"
    link "mcvector_ffi"
    export *
}
