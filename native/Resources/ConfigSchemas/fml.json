    {
      "path": "earlyWindowLogHelpMessage",
      "type": "bool",
      "default": true,
      "min": null,
      "max": null,
      "values": null,
      "since": null,
      "until": null,
      "doc": {
        "en": "Logs a troubleshooting message on the first attempt and is intended to disable itself after a successful launch.",
        "ja": "初回の起動時にトラブルシューティング用のメッセージをログへ出します。起動に成功すると自動で無効になる設定です。"
