      "min": null,
      "max": null,
      "values": null,
      "since": null,
      "until": null,
      "doc": {
        "en": "Lists OpenGL versions to skip, which may help with graphics card driver problems.",
        "ja": "問題のあるグラフィックスドライバーへの対処として、使用しないOpenGLバージョンを列挙します。"
      }
    },
