      "default": "fmlearlywindow",
      "min": null,
      "max": null,
      "values": null,
      "since": null,
      "until": null,
      "doc": {
        "en": "Names the provider used for the early window.",
        "ja": "起動時ウィンドウで使うプロバイダーを指定します。"
      }
    },
