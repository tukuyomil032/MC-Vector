  "entries": [
    {
      "path": "earlyWindowControl",
      "type": "bool",
      "default": true,
      "min": null,
      "max": null,
      "values": null,
      "since": null,
      "until": null,
      "doc": {
        "en": "Controls the early window. Disabling it also disables newer OpenGL features and may affect mods that depend on them.",
        "ja": "起動時ウィンドウを制御します。無効にすると新しいOpenGL機能も無効になり、それらに依存するModに影響することがあります。"
      }
    },
    {
      "path": "maxThreads",
      "type": "int",
      "default": -1,
      "min": null,
      "max": null,
      "values": null,
      "since": null,
      "until": null,
      "doc": {
        "en": "Sets the maximum number of threads for parallel early initialization. A value of -1 uses the available processor count.",
        "ja": "起動初期化を並列処理するときの最大スレッド数を指定します。-1の場合は利用可能なプロセッサ数を使います。"
      }
    },
    {
      "path": "versionCheck",
      "type": "bool",
      "default": true,
      "min": null,
      "max": null,
      "values": null,
      "since": null,
      "until": null,
      "doc": {
        "en": "Enables Forge's global version check.",
        "ja": "Forge全体のバージョン確認を有効にします。"
      }
    },
    {
      "path": "defaultConfigPath",
      "type": "string",
      "default": "defaultconfigs",
      "min": null,
      "max": null,
      "values": null,
      "since": null,
      "until": null,
      "doc": {
        "en": "Sets the server directory from which Forge copies default mod configuration files.",
        "ja": "ForgeがModの初期設定ファイルをコピーする元のサーバーディレクトリを指定します。"
      }
    },
    {
      "path": "disableOptimizedDFU",
      "type": "bool",
      "default": true,
      "min": null,
      "max": null,
      "values": null,
      "since": null,
      "until": null,
      "doc": {
        "en": "Disables Optimized DataFixerUpper on the client; Forge already disables it on servers.",
        "ja": "クライアントでOptimized DataFixerUpperを無効にします。サーバーではForgeがすでに無効にしています。"
      }
    },
    {
