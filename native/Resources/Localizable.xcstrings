    "plugins.browser.unverifiedInstallDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This plugin was not installed because the provider did not supply a checksum. The artifact cannot be verified safely. You can allow hashless downloads in General Settings, but URL, destination, redirect, archive, and size protections remain active."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダーがチェックサムを提供していないため、安全性を確認できずインストールを中止しました。全般設定でハッシュなし取得を許可できますが、URL、配置先、リダイレクト、アーカイブ、サイズの保護は引き続き有効です。"
          }
        }
      }
    },
