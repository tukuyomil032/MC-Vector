    "ngrokGuide.introRequirements": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A free ngrok account and authentication token are required."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用には無料の ngrokアカウント と 認証トークン が必要です。"
          }
        }
      }
    },
    "ngrokGuide.introText": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This feature allows you to invite friends from around the world to your server without complicated router settings (port forwarding)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この機能を使うと、難しいルーターの設定（ポート開放）をせずに、世界中の友達をあなたのサーバーに招待できます。"
          }
        }
      }
    },
    "ngrokGuide.openLinkFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not open the link in your browser"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザでリンクを開けませんでした"
          }
        }
      }
    },
    "ngrokGuide.step1.badge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step 1"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステップ 1"
          }
        }
      }
    },
    "ngrokGuide.step1.button": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open ngrok Dashboard"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ngrok ダッシュボードを開く"
          }
        }
      }
    },
    "ngrokGuide.step1.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visit the ngrok official site and create an account (Sign up) or log in."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ngrokの公式サイトにアクセスし、アカウントを作成（サインアップ）またはログインしてください。"
          }
        }
      }
    },
    "ngrokGuide.step1.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On first visit, you will see installation instructions on the dashboard, but since this app manages binaries internally, just obtaining the token is sufficient."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初回はダッシュボードの案内に従ってインストール案内が表示されますが、本アプリではバイナリ管理を内部で行うためトークン取得だけで十分です。"
          }
        }
      }
    },
    "ngrokGuide.step1.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access Official Site"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公式サイトへアクセス"
          }
        }
      }
    },
    "ngrokGuide.step2.badge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step 2"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステップ 2"
          }
        }
      }
    },
    "ngrokGuide.step2.description1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click \"Your Authtoken\" from the left menu on the dashboard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダッシュボードの左メニューから \"Your Authtoken\" をクリックします。"
          }
        }
      }
    },
    "ngrokGuide.step2.description2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy the long string starting with 2A... displayed at the top of the page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページ上部に表示されている 2A… などから始まる長い文字列をコピーしてください。"
          }
        }
      }
    },
    "ngrokGuide.step2.securityWarning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Security Warning: This token is equivalent to a password. Do not paste it in chat or on stream screens."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セキュリティ注意: このトークンはパスワード同等です。チャットや配信画面へ貼り付けないでください。"
          }
        }
      }
    },
    "ngrokGuide.step2.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy Authtoken (Authentication Token)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Authtoken (認証トークン) をコピー"
          }
        }
      }
    },
    "ngrokGuide.step3.addressNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "※ The address changes each time. Share the new address with friends each time you play."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "※ アドレスは毎回変わります。遊ぶたびに新しいアドレスを友達に教えてあげてください。"
          }
        }
      }
    },
    "ngrokGuide.step3.badge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step 3"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステップ 3"
          }
        }
      }
    },
    "ngrokGuide.step3.description1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return to the General Settings tab in this app and turn on the switch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリの全般設定タブに戻り、スイッチをオンにしてください。"
          }
        }
      }
    },
    "ngrokGuide.step3.description2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When prompted for a token, paste the string you copied earlier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トークンの入力を求められるので、先ほどコピーした文字列を貼り付けてください。"
          }
        }
      }
    },
    "ngrokGuide.step3.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection Test: Copy the displayed address and test by joining directly from another PC or friend's environment. If unable to connect, check the server-side logs first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続テスト手順: 表示アドレスをコピーし、別PCまたは友人環境から直接参加して確認します。入れない場合はサーバー側ログを先に確認してください。"
          }
        }
      }
    },
    "ngrokGuide.step3.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter in App and Connect"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリに入力して接続"
          }
        }
      }
